SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:password@localhost:5432/friday_db

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# NewsAPI (https://newsapi.org)
NEWS_API_KEY=

# AI Provider: "ollama" for local dev, "gemini" for production
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=Friday:latest
GEMINI_API_KEY=

# Paystack (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_PLAN_CODE_PRO=PLN_your_pro_plan_code
PAYSTACK_PLAN_CODE_PREMIUM=PLN_your_premium_plan_code


# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:5173
